{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.php",
      "use": "vercel-php@0.6.0"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/admin/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/blog/([^/]+)",
      "dest": "/blog-detail.php?slug=$1"
    },
    {
      "src": "/projects/([^/]+)",
      "dest": "/project-detail.php?slug=$1"
    },
    {
      "src": "/((?!api|admin|assets|blog|projects).*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "DB_HOST": "@db_host",
    "DB_NAME": "@db_name",
    "DB_USER": "@db_user",
    "DB_PASS": "@db_pass",
    "SITE_URL": "@site_url"
  },
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.6.0"
    }
  }
}